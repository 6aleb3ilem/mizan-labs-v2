# Copy to backend/.env for local development. Every value has a safe default for `dev`.
MIZAN_ENV=dev
SECRET_KEY=dev-only-change-me
DEBUG=true
DATABASE_URL=postgresql://mizan:mizan@127.0.0.1:5432/mizan
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Object storage (S3 API; MinIO locally, Cloudflare R2 in the cloud). Leave endpoint empty to use local files.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=mizan
S3_SECRET_ACCESS_KEY=mizan-secret
S3_BUCKET_DOCUMENTS=mizan-documents
S3_BUCKET_ATTACHMENTS=mizan-attachments

# E-mail (Mailpit locally)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_FROM=Mizan Labs <no-reply@mizanlabs.local>

# Signing (dev: PEM files generated on demand under var/keys; prod: KMS resource names)
SIGNING_BACKEND=local
SIGNING_LOCAL_DIR=var/keys
TSA_URL=

# Public origins (used in links inside documents and messages)
VERIFY_BASE_URL=http://localhost:5176
PORTAL_BASE_URL=http://localhost:5175

# Notification channels (SPEC §19.2). "log" providers only record the message (dev/test).
NOTIFY_EMAIL_PROVIDER=smtp
SMS_PROVIDER=log
SMS_URL=
SMS_TOKEN=
SMS_SENDER=MizanLabs
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
